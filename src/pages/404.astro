---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---

<Base title="Page not found">
  <section class="section">
    <div class="container wrap">
      <p class="eyebrow">404</p>
      <h1 class="h2">We couldn't find that page.</h1>
      <p class="lede">It may have moved when we rebuilt the site.</p>
      <div class="links">
        <a href={url("/")} class="btn btn-dark">Go to the home page</a>
        <a href={url("/#research")} class="btn btn-outline">See our research</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .wrap {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
</style>

---
import { aiPrinciples } from "../../data/site";

const uses = [
  "Early disease detection",
  "Outbreak forecasting",
  "Patient risk stratification",
  "Targeting scarce resources",
  "Decision-support dashboards",
  "Faster analysis and reporting",
];
---

<section id="ai" class="section ai" aria-labelledby="ai-title">
  <div class="container">
    <div class="intro">
      <p class="eyebrow">AI in our work</p>
      <h2 id="ai-title" class="h2">Proven AI tools, applied with care</h2>
      <p class="lede">
        We use established AI tools and machine-learning methods to analyse data, build systems and deliver faster.
        What we add is the discipline to test the results, explain them, and fit them to African data.
      </p>
    </div>

    <ol class="principles">
      {
        aiPrinciples.map((p, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="uses">
      <h3>Where we apply AI</h3>
      <ul>
        {uses.map((u) => <li>{u}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .ai {
    background: var(--ink);
    color: var(--white);
  }
  .ai .eyebrow {
    color: var(--gold);
  }
  .intro {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 56px;
  }
  .ai .lede {
    color: var(--on-green);
  }
  .principles {
    list-style: none;
    margin: 0 0 56px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px;
  }
  .principles li {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    padding: clamp(28px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .num {
    font-size: 15px;
    font-weight: 800;
    color: var(--gold);
  }
  .principles h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(22px, 2vw, 26px);
    line-height: 1.25;
  }
  .principles p {
    color: var(--on-green);
  }
  .uses h3 {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 18px;
  }
  .uses ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .uses li {
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 15px;
  }
</style>

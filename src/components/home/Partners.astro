---
import { partners } from "../../data/site";
---

{
  partners.length > 0 && (
    <section class="partners" aria-labelledby="partners-title">
      <div class="container">
        <h2 id="partners-title" class="eyebrow">Institutions we've worked with</h2>
        <ul>
          {partners.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .partners {
    border-top: 1px solid var(--line);
    padding-block: 56px;
  }
  h2 {
    text-align: center;
    margin-bottom: 28px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }
  li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 14px 24px;
    font-weight: 700;
    color: var(--muted);
    text-align: center;
  }
</style>

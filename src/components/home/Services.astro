---
import { services } from "../../data/site";
import { url } from "../../lib/url";

// Simple stroke icons, one per service in the same order as `services`.
const icons = [
  "M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z",
  "M8 7l-5 5 5 5 M16 7l5 5-5 5 M14 4l-4 16",
  "M22 12h-4l-3 9L9 3l-3 9H2",
  "M3 3v18h18 M7 15l4-4 3 3 5-6",
  "M21 12a9 9 0 1 1-3-6.7 M21 4v5h-5",
];
---

<section id="services" class="section services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">What we do</p>
        <h2 id="services-title" class="h2">AI at the core of everything we deliver</h2>
      </div>
      <p>Every engagement is led by one of our founders, from the first model to the final briefing.</p>
    </div>
    <div class="grid">
      {
        services.map((s, i) => (
          <article class:list={{ lead: i === 0 }}>
            <svg aria-hidden="true" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d={icons[i]} />
            </svg>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))
      }
      <article class="cta">
        <p class="cta-text">Not sure which service fits? Tell us the decision you need to make.</p>
        <a href={url("/#contact")} class="arrow-link">Start a conversation →</a>
      </article>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  article {
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  svg {
    color: var(--green-2);
  }
  h3 {
    font-size: 21px;
    font-weight: 700;
  }
  article p {
    color: var(--muted);
  }
  .lead {
    background: var(--green);
    border-color: var(--green);
    color: var(--white);
  }
  .lead svg {
    color: var(--gold);
  }
  .lead h3 {
    font-size: clamp(22px, 2.2vw, 26px);
  }
  .lead p {
    color: var(--on-green);
  }
  /* Wide screens: lead service spans two columns, the CTA becomes a full-width band. */
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .lead {
      grid-column: span 2;
    }
    .cta {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
  }
  .cta {
    background: var(--gold);
    border-color: var(--gold);
    justify-content: space-between;
    gap: 24px;
  }
  .cta .cta-text {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.35;
    color: var(--ink);
  }
  .cta a {
    color: var(--ink);
  }
</style>

---
import { services } from "../../data/site";
import { url } from "../../lib/url";

// Simple stroke icons, one per service in the same order as `services`.
const icons = [
  "M22 12h-4l-3 9L9 3l-3 9H2",
  "M3 3v18h18 M7 15l4-4 3 3 5-6",
  "M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z",
  "M21 12a9 9 0 1 1-3-6.7 M21 4v5h-5",
  "M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5",
];
---

<section id="services" class="section services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">What we do</p>
        <h2 id="services-title" class="h2">Five services, one standard of rigour</h2>
      </div>
      <p>Every engagement is led by a founding biostatistician, from the first protocol to the final briefing.</p>
    </div>
    <div class="grid">
      {
        services.map((s, i) => (
          <article>
            <svg aria-hidden="true" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d={icons[i]} />
            </svg>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))
      }
      <article class="cta">
        <p class="cta-text">Not sure which service fits? Tell us the decision you need to make.</p>
        <a href={url("/#contact")} class="arrow-link">Start a conversation →</a>
      </article>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  article {
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  svg {
    color: var(--green-2);
  }
  h3 {
    font-size: 21px;
    font-weight: 700;
  }
  article p {
    color: var(--muted);
  }
  .cta {
    background: var(--gold);
    border-color: var(--gold);
    justify-content: space-between;
    gap: 24px;
  }
  .cta .cta-text {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.35;
    color: var(--ink);
  }
  .cta a {
    color: var(--ink);
  }
</style>

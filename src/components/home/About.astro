---
import { mission, values, vision } from "../../data/site";
---

<section id="about" class="section about" aria-labelledby="about-title">
  <div class="container">
    <div class="intro">
      <p class="eyebrow">About us</p>
      <h2 id="about-title" class="h2">Analytics and research with clinical-grade rigour</h2>
      <p class="lede">
        Insight Analytics Africa is a data analytics and research company based in Kampala. We champion the use of AI
        to develop systems that raise the standard of evidence behind decisions on the continent. We work across sectors,
        with a deep specialism in public health, and the people who build your models are the people who advise you on
        what they mean.
      </p>
    </div>

    <div class="mv">
      <article>
        <p class="tag">Mission</p>
        <h3>{mission.title}</h3>
        <p>{mission.body}</p>
      </article>
      <article>
        <p class="tag">Vision</p>
        <h3>{vision.title}</h3>
        <p>{vision.body}</p>
      </article>
    </div>

    <h3 class="values-title">What we stand for</h3>
    <ul class="values">
      {
        values.map((v) => (
          <li>
            <h4>{v.title}</h4>
            <p>{v.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    background: var(--green);
    color: var(--white);
  }
  .about .eyebrow {
    color: var(--gold);
  }
  .intro {
    max-width: 860px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 56px;
  }
  .about .lede {
    color: var(--on-green);
  }
  .mv {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 20px;
    margin-bottom: 64px;
  }
  .mv article {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 22px;
    padding: clamp(28px, 3.5vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tag {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .mv h3 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.25;
  }
  .mv p:last-child,
  .values p {
    color: var(--on-green);
  }
  .values-title {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 24px;
  }
  .values {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 32px;
  }
  .values li {
    border-top: 2px solid var(--gold);
    padding-top: 20px;
  }
  h4 {
    margin: 0 0 8px;
    font-size: 19px;
    font-weight: 700;
  }
</style>

---
import { Image } from "astro:assets";
import hero from "../../assets/hero.jpg";
// import { url } from "../../lib/url"; // needed again when the hero buttons below are restored
---

<section class="hero">
  <div class="container">
    <p class="eyebrow tag">AI-powered analytics · Kampala, Uganda</p>
    <h1>We use AI to turn data into <span>decisions you can trust.</span></h1>
    <div class="row">
      <p class="lede">
        Insight Analytics Africa is a data analytics and research company. We put today's AI tools to work to analyse
        data, build systems and deliver research for health and development, and we check every result before anyone
        relies on it.
      </p>
      {/* Hidden for now. To restore, uncomment this block and the `url` import at the top.
      <div class="ctas">
        <a href={url("/#contact")} class="btn btn-gold">Start an AI project</a>
        <a href={url("/#ai")} class="btn btn-outline">How we use AI</a>
      </div>
      */}
    </div>
    <Image
      src={hero}
      alt="Two analysts discussing data dashboards in a meeting room"
      widths={[640, 1024, 1280]}
      sizes="(max-width: 1280px) 100vw, 1216px"
      loading="eager"
      fetchpriority="high"
      class="photo"
    />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 6vw, 72px);
  }
  .tag {
    margin-bottom: 18px;
  }
  h1 {
    font-weight: 800;
    font-size: clamp(42px, 6.4vw, 92px);
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 1100px;
    margin-bottom: 28px;
  }
  h1 span {
    color: var(--green-2);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 28px 32px;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 40px;
  }
  .row .lede {
    flex: 1 1 480px;
    max-width: 640px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .photo {
    width: 100%;
    height: clamp(260px, 38vw, 540px);
    object-fit: cover;
    object-position: center 40%;
    border-radius: 28px;
  }
</style>
